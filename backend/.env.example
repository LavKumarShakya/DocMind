# Local backend development. Copy to `.env` inside backend/.
# docker-compose passes equivalent variables via its own environment block.

DATABASE_URL=postgresql+psycopg://campusrag:campusrag_dev_password@localhost:5432/campusrag
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
EMBEDDING_DIM=768
