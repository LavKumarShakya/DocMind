# Local backend development. Copy to `.env` inside backend/.
# docker-compose passes equivalent variables via its own environment block.
#
# PRODUCTION-SENSITIVE: never run a real deployment with the placeholder
# values below. Set a strong random SECRET_KEY and a strong DB password, and
# keep them out of version control.

DATABASE_URL=postgresql+psycopg://docmind:docmind_dev_password@localhost:5432/docmind
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
EMBEDDING_DIM=768

# --- Phase 3: ingestion ---
# sentence-transformers model; output dimension MUST equal EMBEDDING_DIM.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Local storage root (relative to the backend working directory). Replaceable.
STORAGE_DIR=storage
# Max upload size in bytes (20 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520
# Character-based chunking.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Phase 4: RAG ---
# Retrieval parameters.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.65
MAX_CONTEXT_CHARS=8000
MAX_MESSAGE_LENGTH=2000
# LLM provider: "gemini" (needs GEMINI_API_KEY) or "local" (offline dev only).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
# Google AI Studio API key. NEVER commit a real key.
GEMINI_API_KEY=

# --- Phase 5: hybrid retrieval ---
# Dense and BM25 candidate pool sizes (merged + deduped before reranking).
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
# Number of fused candidates sent to the cross-encoder reranker.
RERANK_TOP_K=8
# Fusion weights (normalized scores).
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
# Cross-encoder reranker model and inference batch size.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=8
# Minimum top reranker relevance (0..1) required before answering.
CONFIDENCE_THRESHOLD=0.35
