# ==========================================================================
# CampusRAG environment configuration
# Copy this file to `.env` (same directory) and adjust values as needed.
# NEVER commit real credentials. This file only contains dev-safe defaults.
#
# This file is consumed by docker-compose.yml (variable substitution) and
# is also used by the local development instructions in the README.
# ==========================================================================

# --- PostgreSQL (used by docker-compose.yml and local DATABASE_URL) ---
POSTGRES_USER=campusrag
POSTGRES_PASSWORD=campusrag_dev_password
POSTGRES_DB=campusrag

# --- Backend (FastAPI) ---
# Local development points at localhost; docker-compose overrides the host
# with the `db` service name automatically.
DATABASE_URL=postgresql+psycopg://campusrag:campusrag_dev_password@localhost:5432/campusrag
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=true
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Must match the vector dimension of the embedding model used in Phase 3+.
EMBEDDING_DIM=768
# sentence-transformers model; output dimension MUST equal EMBEDDING_DIM.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Local storage root (relative to the backend working directory). Replaceable.
STORAGE_DIR=storage
# Max upload size in bytes (20 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520
# Character-based chunking.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
