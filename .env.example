# ==========================================================================
# DocMind environment configuration
# Copy this file to `.env` (same directory) and adjust values as needed.
# NEVER commit real credentials. This file only contains dev-safe defaults.
#
# This file is consumed by docker-compose.yml (variable substitution) for the
# self-hosted stack, and by the local development instructions in the README.
#
# Two runtime modes are supported by the same repository:
#   DEMO_MODE=false  -> full self-hosted application (upload your own PDFs)
#   DEMO_MODE=true   -> public demo (single pre-indexed PDF, no uploads)
# DEMO_MODE defaults to false.
# ==========================================================================

# --- PostgreSQL (used by docker-compose.yml and local DATABASE_URL) ---
# PRODUCTION-SENSITIVE: set a strong random password for POSTGRES_PASSWORD.
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind_dev_password
POSTGRES_DB=docmind

# --- Backend (FastAPI) ---
# The self-hosted Compose stack overrides the host with the `db` service name
# automatically; this value is used for local (non-Docker) development.
DATABASE_URL=postgresql+psycopg://docmind:docmind_dev_password@localhost:5432/docmind
# PRODUCTION-SENSITIVE: set a strong random string (32+ bytes).
SECRET_KEY=dev-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=production
DEBUG=false
# Comma-separated list of allowed browser origins. For self-hosting on a single
# machine this stays http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# --- Embeddings ---
# Must match the vector dimension of the embedding model used in Phase 3+.
EMBEDDING_DIM=768
# sentence-transformers model; output dimension MUST equal EMBEDDING_DIM.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Storage & model cache (persistent Docker volumes) ---
# In the self-hosted Compose stack these are mounted on named volumes so data
# survives container recreation. Local (non-Docker) dev may keep them relative.
STORAGE_DIR=/data/storage
HF_HOME=/data/huggingface

# Max upload size in bytes (20 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520
# Character-based chunking.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.65
MAX_CONTEXT_CHARS=8000
MAX_MESSAGE_LENGTH=2000

# --- LLM ---
# Provider: "gemini" (needs GEMINI_API_KEY) or "local" (offline dev only).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
# Google AI Studio API key. NEVER commit a real key; set it in your local .env
# only. The frontend image never sees this value.
GEMINI_API_KEY=

# --- Hybrid retrieval ---
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
RERANK_TOP_K=8
HYBRID_DENSE_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=8
CONFIDENCE_THRESHOLD=0.35

# --- Public demo mode (Phase 9) ---
# Set DEMO_MODE=true to expose the unauthenticated public demo that answers
# questions only from a single pre-indexed PDF (no upload required). PDF
# upload/processing are disabled while demo mode is on. Build the demo index
# once with `docker compose exec backend python -m scripts.build_demo_index`
# (or `python -m scripts.build_demo_index` from the backend dir).
# Leave DEMO_MODE=false for the full self-hosted upload/chat workflow.
DEMO_MODE=false
# Path to the demo PDF (absolute, or relative to the backend working dir;
# the default resolves to Doc/DocMind_Public_Demo_Test_Document.pdf).
DEMO_DOCUMENT_PATH=../Doc/DocMind_Public_Demo_Test_Document.pdf
# Fixed id of the demo document and its display title. Do not change after
# the index has been built (the build script uses them as the row identity).
DEMO_DOCUMENT_ID=11111111-1111-4111-8111-111111111111
DEMO_DOCUMENT_TITLE=DocMind Public Demo Test Document

# --- Frontend (Next.js) ---
# Baked into the client bundle at build time (NEXT_PUBLIC_*). The browser calls
# the backend directly, so this is the backend's host-published URL.
NEXT_PUBLIC_API_URL=http://localhost:8000